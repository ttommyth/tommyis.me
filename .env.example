# Copy this file to `.env.local` and fill in real values.
# Never commit real secrets. `.env*` files are gitignored.

# --- reCAPTCHA v3 ---
# Public site key (safe to expose to the browser).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret server key. Keep private.
RECAPTCHA_SERVER_KEY=

# --- Discord feedback webhook ---
# Full webhook URL used by /api/contact to post feedback messages.
DISCORD_WEBHOOK_FEEDBACK_URL=

# --- Site URL ---
# Used for building absolute URLs (e.g. OG image URLs) when not on Vercel.
NEXT_PUBLIC_SITE_URL=https://tommyis.me
